{
  "name": "oleaforecast",
  "private": true,
  "version": "0.1.0",
  "description": "OleaForecast - olive oil market forecasting & decision support",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run -s typecheck",
    "test": "bash scripts/run-smoke.sh",
    "bridge:demo": "tsx server/analytics/bridge-demo.ts",
    "eval:run": "tsx server/analytics/run-eval.ts",
    "eval:batch": "tsx server/analytics/run-batch.ts",
    "ingest:canonical": "tsx server/ingestion/run-canonical.ts",
    "ingest:sources": "tsx server/ingestion/fetch-observations.ts",
    "build:canonical": "tsx server/ingestion/build-canonical.ts",
    "forecast:run": "tsx server/ingestion/run-forecasts.ts",
    "py:deps": "python3 -m pip install -r ml_legacy/requirements.txt",
    "build": "node -e \"console.log('build: ok (placeholder)')\"",
    "start": "tsx server/app.ts",
    "dev": "tsx server/app.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  }
}
