# OleaForecast - Environment Template
# Copy to .env in your runtime environment (DO NOT commit .env)

NODE_ENV=development
PORT=3000

# ========================
# Optional: Database
# ========================
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/oleaforecast

# ========================
# External APIs (placeholders)
# ========================
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# ========================
# Data sources (optional)
# ========================
# ECB_FX_URL=
# POOLRED_URL=
# AICA_URL=
# IOC_URL=

# ========================
# App flags
# ========================
# ENABLE_ML_SERVICE=false
# LOG_LEVEL=info
